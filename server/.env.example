SUPABASE_URL=

# MUST be the service_role key (Dashboard > Project Settings > API Keys).
# The anon key returns empty results: every public table has RLS on with no policies.
SUPABASE_KEY=

# Signs session JWTs. Must be >= 32 chars.
SESSION_SECRET=

# Resend SMTP. MAIL_PASSWORD is a Resend API key (re_...).
# MAIL_DEFAULT_SENDER must be on a domain verified in Resend.
MAIL_SERVER=smtp.resend.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@kumpas.live

# Seconds the campus snapshot (buildings, pathways, routing graph) is held in
# memory before it is re-read. Admin edits appear within this window.
CAMPUS_CACHE_TTL=300

# Bearer token for POST /campus/refresh-cache, which publishes admin edits
# immediately instead of waiting out CAMPUS_CACHE_TTL. Must be >= 16 chars;
# the endpoint returns 503 while it is unset.
ADMIN_REFRESH_TOKEN=

# Seconds before a Supabase call is abandoned. Handlers run on a 40-thread
# pool, so a hung call must not hold a thread for PostgREST's 120 s default.
SUPABASE_TIMEOUT=10
